# /opt/rewrite/rewrite.env —— systemd EnvironmentFile
#
# 所有部署细节集中在这里，代码里不写死 IP / 端口 / 凭据。
# 前缀统一 REWRITE_，方便和旧栈并存。

# ---- 本服务 ----
REWRITE_HOST=0.0.0.0
# ★ 8890 就是平台自己的端口。迁移期曾用过 8903 做暂存（当时 8890 还跑着旧
#   charles-console），旧管理台删掉之后 8903 就退休了 —— 全新部署请直接用 8890，
#   别再抄那个旧值，否则服务会绑到一个没人访问的端口上。
REWRITE_PORT=8890
# 前端同源托管时不需要 CORS；开发期放本机 vite。
REWRITE_CORS=http://127.0.0.1:5173

# ---- 鉴权 ----
# ★ 上线前必须换成随机值：
#     openssl rand -base64 48 | tr -d '\n'
# 留空会退化成进程级临时密钥 —— 每次重启所有会话失效（能跑，但不是你要的）。
REWRITE_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
REWRITE_JWT_TTL=43200
# ★ 生产必须 false。true = 任何人可匿名访问全部接口。
REWRITE_ALLOW_ANON=false

# 初始管理员（仅首次建库时生效，之后改这里无效，用界面改密码）。
REWRITE_ADMIN_USER=admin
REWRITE_ADMIN_PASS=CHANGE_ME_strong_password

# ---- 数据层 ----
REWRITE_DATA_DIR=/opt/rewrite/var

# ---- 上游：适配层（既有服务，原样保留，不重写）----
REWRITE_CCPX_ADMIN=http://127.0.0.1:8893
REWRITE_CCPX_USER=admin
# 留空即可 —— 默认从 /opt/ccpx/config.json 现读（ccpx_creds_from_file=true）。
# 这样在适配层改了管理密码不需要重启本服务。
REWRITE_CCPX_PASS=
REWRITE_CCPX_CONFIG=/opt/ccpx/config.json
REWRITE_CCPX_CREDS_FROM_FILE=true
REWRITE_CCPX_CREDS_TTL=10
REWRITE_CCPX_LOG=/opt/ccpx/adapter.log
REWRITE_CCPX_UNIT=ccpx

# ---- 上游：Charles ----
REWRITE_CHARLES_WEBIF=http://127.0.0.1:18888
REWRITE_CHARLES_HTTP_PORT=18888
REWRITE_CHARLES_UNIT=charles-headless
# ★ Charles 的配置是**一个单文件**，不是目录里的 config.xml。
#   写成 ~/.charles/config.xml 会让配置页静默读到空、写入写到没人看的文件
#   （线上实测过：~/.charles/ 下只有 ca/ certs/ profiles/ backup/，
#    真文件是 ~/.charles.config，14077 字节）。
REWRITE_CHARLES_CFG=/home/ubuntu/.charles.config
REWRITE_CHARLES_JAR=/opt/charles-proxy/lib/charles.jar
# Charles 授权。留空则**不注入**，只如实读取现有注册状态。
# 格式就是配置里 <registrationConfiguration> 的那一对：
#   REWRITE_CHARLES_LICENSE_NAME=your-license-name
#   REWRITE_CHARLES_LICENSE_KEY=0000000000000000
REWRITE_CHARLES_LICENSE_NAME=
REWRITE_CHARLES_LICENSE_KEY=

# ---- 设备侧（无登录）资源 ----
# ★ 规则集放本服务自己的目录，不要指回旧 charles-console 的目录 ——
#   那个目录已经删了。deploy.sh 首次部署时会从旧路径自动搬一次。
REWRITE_RULESET=/opt/rewrite/ruleset.conf
REWRITE_CHARLES_CA_DIR=/home/ubuntu/.charles/ca

# ---- 行为 ----
REWRITE_UPSTREAM_TIMEOUT=30
REWRITE_MAX_UPSTREAM=67108864
