[Unit]
Description=CCProxy protocol adapter (yihua card-system backend)
Documentation=file:/opt/ccpx/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ccpx
ExecStart=/usr/bin/python3 /opt/ccpx/ccproxy_adapter.py --config /opt/ccpx/config.json
ExecStartPre=/usr/bin/python3 /opt/ccpx/ccproxy_adapter.py --selftest
Restart=always
RestartSec=2
User=ccpx
Group=ccpx
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/ccpx
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
